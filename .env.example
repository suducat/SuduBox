# Alternatively set the public Website ID in src/data/analytics-config.json.
# Umami Cloud → Website → Settings → Website ID (public, not an API key).
# Empty means no analytics script or requests.
VITE_UMAMI_WEBSITE_ID=
# Production hostname only, no protocol/path. Defaults to suducat.github.io.
VITE_UMAMI_HOSTNAME=suducat.github.io
